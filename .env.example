# Token del bot (Discord Developer Portal)
DISCORD_TOKEN=

# ID del servidor de Discord donde este bot debe operar (y unicamente ese)
GUILD_ID=

# --- YouTube ---
# API key de YouTube Data API v3 (Google Cloud Console)
YOUTUBE_API_KEY=
# Channel ID del canal a monitorear (empieza con "UC...", no es el @handle)
YOUTUBE_CHANNEL_ID=
# ID del canal de DISCORD donde se postean los avisos automáticos
YOUTUBE_NOTIFY_CHANNEL_ID=
# Cada cuántos minutos revisa si hay video nuevo (opcional, default 5)
YOUTUBE_POLL_MINUTES=

# Mensajes personalizables por tipo de contenido (opcional, ya traen default).
# Placeholders disponibles: {canal} {titulo} {url}
YOUTUBE_MSG_VIDEO="📺 **{canal}** subió un video nuevo!\n{url}"
YOUTUBE_MSG_SHORT="🔥 **{canal}** subió un Short!\n{url}"
YOUTUBE_MSG_LIVE="🔴 **{canal}** está en VIVO ahora mismo!\n{url}"
